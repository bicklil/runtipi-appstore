{
    "schemaVersion": 2,
    "services": [
        {
            "name": "fugleramme",
            "isMain": true,
            "image": "ghcr.io/arnegiacomo/fugleramme:latest",
            "internalPort": 9112,
            "addPorts": [
                {
                    "containerPort": 8080,
                    "hostPort": 9112
                }
            ],
            "volumes": [
                {
                "hostPath": "${APP_DATA_DIR}/data",
                "containerPath": "/app/data"
                }
            ],
            "environment": [{
            "key":"FUGLERAMME_DETECTOR_URL","value":"http://192.168.1.150:9111"
            }],
            "addToMainNetwork": true
        }
    ]
}
{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "otbr",
      "image": "openthread/border-router:latest",
      "isMain": true,
      "networkMode": "host",
      "privileged": true,
      "devices": [
        "/dev/serial/by-id/${OTBR_DEVICE}:/dev/ttyUSB0"
      ],
      "environment": [
        {
          "key": "OT_RCP_DEVICE",
          "value": "${OTBR_RCP_URL}"
        },
        {
          "key": "OT_INFRA_IF",
          "value": "${OTBR_INFRA_IF}"
        },
        {
          "key": "OT_THREAD_IF",
          "value": "wpan0"
        },
        {
          "key": "OT_LOG_LEVEL",
          "value": "7"
        },
        {
          "key": "OT_WEB_LISTEN_ADDR",
          "value": "0.0.0.0"
        },
        {
          "key": "OT_WEB_LISTEN_PORT",
          "value": "8080"
        },
        {
          "key": "OT_REST_LISTEN_ADDR",
          "value": "0.0.0.0"
        },
        {
          "key": "OT_REST_LISTEN_PORT",
          "value": "8081"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/otbr-data",
          "containerPath": "/data"
        }
      ]
    },
    {
      "name": "matter-server",
      "image": "ghcr.io/matter-js/matterjs-server:stable",
      "networkMode": "host",
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "PORT",
          "value": "8082"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/matter-data",
          "containerPath": "/data"
        },
        {
          "hostPath": "/run/dbus",
          "containerPath": "/run/dbus",
          "readOnly": true
        }
      ]
    }
  ]
}

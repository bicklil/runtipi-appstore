{
  "schemaVersion": 2,
  "services": [
    {
      "name": "birdnet-go",
      "image": "tphakala/birdnet-go:20261031",
      "isMain": true,
      "internalPort": 8080,
      "addPorts": [
        {
          "containerPort": 8080,
          "hostPort": 9111
        }
      ],
      "environment": [
        {
          "key": "TZ",
          "value": "Europe/Paris"
        }
      ]
    }
  ]
}
